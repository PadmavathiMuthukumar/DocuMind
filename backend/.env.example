# Copy this file to .env and edit .env. Never commit .env.

PORT=5000
HOST=127.0.0.1

# Browser addresses allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Used in later steps ---
MONGODB_URI=
SEMANTIC_SERVICE_URL=http://127.0.0.1:8000
SEMANTIC_TIMEOUT_MS=30000
SEMANTIC_INGEST_TIMEOUT_MS=300000

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_UPLOAD=5