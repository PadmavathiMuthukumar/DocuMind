# Copy this file to .env and edit .env (never commit .env)

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Chunk sizes are counted in WORDS
CHUNK_SIZE_WORDS=150
CHUNK_OVERLAP_WORDS=30

MAX_FILE_SIZE_MB=50
MAX_PAGES=500
MAX_CHARS_PER_PAGE=100000

PDF_DIR=data/pdfs
CHROMA_DIR=data/chroma
COLLECTION_NAME=pdf_chunks

TOP_K_DEFAULT=5
# Cosine distance: lower = more similar. Starting value; we tune it in Step 2.2.
MAX_DISTANCE=0.65